{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=ticketing;Username=ticketing_app;Password=123456",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "SuperSecretKeyAtLeast32Characters!!",
    "Issuer": "ticketing-api",
    "Audience": "ticketing-client",
    "ExpirationInMinutes": 60
  },
  "Outbox": {
    "IntervalSeconds": 5,
    "BatchSize": 50,
    "CleanupAfterDays": 7
  },
  "R2": {
    "AccountId": "REPLACE_WITH_CF_ACCOUNT_ID",
    "AccessKey": "REPLACE_WITH_R2_ACCESS_KEY",
    "SecretKey": "REPLACE_WITH_R2_SECRET_KEY",
    "BucketName": "ticketing-events"
  },
  "AllowedHosts": "*"
}
