# ──────────────────────────────────────────────────────────
# Production Environment Variables Template (.env.prod)
# ──────────────────────────────────────────────────────────

# ─── Database ───
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing_app
POSTGRES_PASSWORD=replace_with_strong_password_here

# ─── Redis ───
REDIS_PASSWORD=replace_with_strong_redis_password_here

# ─── Security / JWT ───
JWT_SECRET=replace_with_at_least_32_characters_secret_key!!
JWT_ISSUER=ticketing-api
JWT_AUDIENCE=ticketing-client

# ─── Cloudflare R2 Storage ───
S3_SERVICE_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_r2_access_key
S3_SECRET_KEY=your_r2_secret_key
S3_BUCKET_NAME=ticketing
S3_PUBLIC_URL=https://cdn.yourdomain.id.vn

# ─── Docker Image ───
TICKETING_API_IMAGE=ghcr.io/your_org_or_username/quanlysukienbanve/ticketing-api:latest
